#===============================================================================
# ZLARY FITNESS — ENVIRONMENT VARIABLES
#-------------------------------------------------------------------------------
# Copy this file to `.env.local` for local development, and add the same values
# in Vercel → Project → Settings → Environment Variables for production.
#
# `.env.local` is git-ignored. NEVER commit real keys.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and is
# therefore PUBLIC. Never put a secret behind that prefix.
#
# The site runs with every variable below unset — the video, the calendar, the
# database and the analytics tags each degrade to a designed placeholder rather
# than an error. The one exception is the application form: without Supabase it
# returns a real error instead of a false success.
#===============================================================================

#--- Site -----------------------------------------------------------------------
# Canonical origin, no trailing slash. Used for canonical URLs, Open Graph,
# the sitemap and robots.txt. Set this before launch or those all point at the
# fallback domain in content/site.ts.
NEXT_PUBLIC_SITE_URL=https://zlaryfitness.com


#--- Booking (/book) ------------------------------------------------------------
# Google Calendar Appointment Scheduling (preferred) or Calendly.
# Accepted forms:
#   https://calendar.google.com/calendar/appointments/schedules/XXXX   (embeds)
#   https://calendar.app.google/XXXX                                   (opens in a new tab)
#   https://calendly.com/zlaryfitness/appel-transformation             (embeds)
# Unset → /book shows an administrator placeholder + Instagram fallback.
NEXT_PUBLIC_BOOKING_URL=


#--- VSL video (/vsl) -----------------------------------------------------------
# PROVIDER: youtube | vimeo | wistia | file
# URL:      the video id OR a full share URL (both are handled); for `file`,
#           a path or URL to an .mp4 (e.g. /media/presentation.mp4)
# Either one missing → the page shows "Présentation bientôt disponible".
# Progress events (25/50/75/100%) are only emitted for `file`.
NEXT_PUBLIC_VSL_PROVIDER=
NEXT_PUBLIC_VSL_URL=


#--- Analytics (all optional) ---------------------------------------------------
# Each tag loads ONLY after the visitor accepts the consent banner. Leave every
# one blank and no banner is shown at all.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=


#--- Supabase (application storage) ---------------------------------------------
# Run supabase/migrations/0001_coaching_applications.sql first.
# The anon key is public and unused by the app today (RLS denies it everything);
# it is here for future client-side reads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠ SERVER-ONLY SECRET. Bypasses row-level security. Never expose it to the
# browser, never prefix it with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=


#--- Resend (new-application email) ---------------------------------------------
# Optional. Without both variables, applications are still stored — only the
# notification email is skipped.
RESEND_API_KEY=
# Where the notification is sent. Comma-separate for several recipients.
APPLICATION_NOTIFICATION_EMAIL=
# Optional sender override. Requires a verified domain in Resend.
# Defaults to Resend's shared onboarding sender, which is fine for internal mail.
APPLICATION_NOTIFICATION_FROM="Zlary Fitness <onboarding@resend.dev>"


#--- CRM / automation webhook ---------------------------------------------------
# Optional. Receives the full application as JSON on every successful submit.
# Must be HTTPS. Point it only at an endpoint you control.
APPLICATION_WEBHOOK_URL=
