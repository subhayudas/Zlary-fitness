#===============================================================================
# ZLARY FITNESS - ENVIRONMENT VARIABLES
#-------------------------------------------------------------------------------
# Copy this file to `.env.local` for local development, and add the same values
# in Vercel → Project → Settings → Environment Variables for production.
#
# `.env.local` is git-ignored. NEVER commit real keys.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and is
# therefore PUBLIC. Never put a secret behind that prefix.
#
# The site runs with every variable below unset - the video, the Google Calendar
# integration and the analytics tags each degrade to a designed placeholder
# rather than an error, and the booking calendar falls back to sensible default
# hours. The one exception is Supabase: without it the booking endpoint returns
# a real error rather than a false confirmation, because a slot that was never
# stored is a call nobody turns up to.
#===============================================================================

#--- Site -----------------------------------------------------------------------
# Canonical origin, no trailing slash. Used for canonical URLs, Open Graph,
# the sitemap and robots.txt. Set this before launch or those all point at the
# fallback domain in content/site.ts.
NEXT_PUBLIC_SITE_URL=https://zlaryfitness.com


#--- Booking calendar -----------------------------------------------------------
# The site runs its own calendar: the flow on the homepage asks five questions,
# shows real availability, takes the contact details and confirms the slot.
# EVERY VARIABLE BELOW IS OPTIONAL - the defaults shown are what is used when a
# variable is unset, so the calendar works out of the box.

# IANA time zone the availability below is expressed in. This is the coach's
# clock, and it is what visitors see (named on screen).       default America/Toronto
BOOKING_TIMEZONE=

# Length of the call, in minutes.                                       default 30
BOOKING_DURATION_MINUTES=
# Dead time kept either side of a call. Also spaces the offered slots.  default 15
BOOKING_BUFFER_MINUTES=
# How soon a visitor may book, in hours. Stops "in twenty minutes".     default 12
BOOKING_LEAD_HOURS=
# How far ahead the calendar opens, in days. Capped at 120.             default 21
BOOKING_HORIZON_DAYS=

# Weekly hours: `<days> <ranges>` entries separated by `;`.
# Days are `mon`, `mon-fri` or `mon,wed,fri`. Ranges are `HH:MM-HH:MM`.
# An unparseable value falls back to the default rather than opening nothing.
#                              default "mon-fri 09:00-12:00,17:00-20:00; sat 09:00-12:00"
BOOKING_HOURS=

# Days closed regardless of the weekly hours. Comma-separated `YYYY-MM-DD`.
BOOKING_BLACKOUT_DATES=

# Where the call happens. Shown on screen, in the invitation and on the calendar
# event - put a Zoom/Meet link here if the call is not by phone.
# Unset → "Appel téléphonique - Zach t'appelle au numéro fourni."
BOOKING_LOCATION=

# Organizer address on the `.ics` invitation. Falls back to the notification
# address, then the confirmation sender, then contact@<your domain>.
BOOKING_ORGANIZER_EMAIL=


#--- Google Calendar (optional) -------------------------------------------------
# Without these, bookings are still stored, confirmed and emailed with an
# invitation attached - only the event on Zach's own calendar is skipped.
#
# Setup:
#   1. Google Cloud console → create a service account → create a JSON key.
#   2. Enable the Google Calendar API on that project.
#   3. Google Calendar → Zach's calendar → Settings → "Share with specific
#      people" → add the service-account email with "Make changes to events".
#
# The calendar to write to. Usually the coach's own address.
GOOGLE_CALENDAR_ID=
# `...@...iam.gserviceaccount.com` from the JSON key.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# ⚠ SERVER-ONLY SECRET. The `private_key` field of the JSON key. Paste it with
# the literal \n sequences intact, or base64-encode the whole PEM - both work.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Google Workspace only. With domain-wide delegation set up, the address the
# service account acts as - this is what lets Google itself invite the applicant
# as a real attendee. On a personal Gmail account, leave it blank: the applicant
# is invited by the .ics attached to their confirmation email instead.
GOOGLE_IMPERSONATE_SUBJECT=


#--- VSL video (/vsl) -----------------------------------------------------------
# PROVIDER: youtube | vimeo | wistia | file
# URL:      the video id OR a full share URL (both are handled); for `file`,
#           a path or URL to an .mp4 (e.g. /media/presentation.mp4)
# Either one missing → the page shows "Présentation bientôt disponible".
# Progress events (25/50/75/100%) are only emitted for `file`.
NEXT_PUBLIC_VSL_PROVIDER=
NEXT_PUBLIC_VSL_URL=


#--- Analytics (all optional) ---------------------------------------------------
# Each tag loads ONLY after the visitor accepts the consent banner. Leave every
# one blank and no banner is shown at all.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=


#--- Supabase (booking storage) -------------------------------------------------
# REQUIRED for the booking flow. Run BOTH migrations, in order:
#   supabase/migrations/0001_coaching_applications.sql
#   supabase/migrations/0002_booking_flow.sql
# The anon key is public and unused by the app today (RLS denies it everything);
# it is here for future client-side reads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠ SERVER-ONLY SECRET. Bypasses row-level security. Never expose it to the
# browser, never prefix it with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=


#--- Resend (booking emails) ----------------------------------------------------
# Optional. Without both variables, bookings are still stored and the slot is
# still held - only the emails are skipped.
RESEND_API_KEY=
# Where the "new booking" notification is sent, with the invitation attached.
# Comma-separate for several recipients.
APPLICATION_NOTIFICATION_EMAIL=
# Optional sender override. Requires a verified domain in Resend.
# Defaults to Resend's shared onboarding sender, which is fine for internal mail.
APPLICATION_NOTIFICATION_FROM="Zlary Fitness <onboarding@resend.dev>"

# Sender for the confirmation the APPLICANT receives - the one carrying the
# calendar invitation - written in the language they chose on their first visit.
# Leave it blank and no confirmation is sent: the booking is still stored, Zach
# still gets his notification, and the confirmation screen tells the visitor
# plainly that no email is coming.
# It must be an address on a domain verified in Resend: the shared
# onboarding@resend.dev sender can only deliver to the Resend account owner, so
# using it here would silently drop every applicant's confirmation.
APPLICATION_CONFIRMATION_FROM=


#--- CRM / automation webhook ---------------------------------------------------
# Optional. Receives the full booking as JSON on every confirmed appointment -
# answers, slot, lead quality. Must be HTTPS. Point it only at an endpoint you
# control.
APPLICATION_WEBHOOK_URL=
